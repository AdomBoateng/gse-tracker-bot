# nginx site for GSE Tracker: serves the built Vue SPA and reverse-proxies
# /api to the local gunicorn backend (same-origin, so no CORS needed).
# setup.sh substitutes __DOMAIN__ and __APP_DIR__ and installs this to
# /etc/nginx/sites-available/gse-tracker. `certbot --nginx` later rewrites this
# to add the TLS (443) server block and an HTTP->HTTPS redirect.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __APP_DIR__/frontend/dist;
    index index.html;

    # Proxy API calls to the backend (gunicorn on localhost:8000).
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # SPA fallback for Vue Router client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache built, fingerprinted assets aggressively.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
